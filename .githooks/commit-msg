#!/usr/bin/env bash
# Hook local de commit-msg: exige Conventional Commits (ver CONTRIBUTING.md).
set -euo pipefail
msg_file="$1"
first_line=$(sed -n '1p' "$msg_file")

# Permite merges, reverts automáticos e fixups.
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|content|chore|refactor|test|perf|build|style|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'
if ! echo "$first_line" | grep -qE "$pattern"; then
  cat >&2 <<EOM
commit-msg: a primeira linha não segue Conventional Commits.
  Formato: <tipo>(<escopo opcional>): <descrição no imperativo, até 72 caracteres>
  Tipos:   feat fix docs content chore refactor test perf build style revert
  Exemplo: content(M01): adiciona aula M01-03 sobre prazos e ETA
Recebido: $first_line
EOM
  exit 1
fi
